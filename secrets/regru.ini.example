# Учётные данные API reg.ru для подтверждения через DNS.
#
# Скопируйте в secrets/regru.ini и заполните. Файл в репозиторий не попадает.
# Пароль нужен отдельный, для API, а не от личного кабинета: заведите его в
# разделе «Управление API» на reg.ru и разрешите доступ с IP сервера.
#
# После заполнения обязательно ограничьте права:
#   chmod 600 secrets/regru.ini
dns_regru_username=ваш_логин_reg_ru
dns_regru_password=пароль_от_API

# Если в личном кабинете включена авторизация по сертификату (mTLS),
# раскомментируйте и укажите пути внутри контейнера:
# dns_regru_cert=/etc/letsencrypt/regru-client.crt
# dns_regru_key=/etc/letsencrypt/regru-client.key
