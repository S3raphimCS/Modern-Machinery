# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
# В production обязателен, значения по умолчанию нет — приложение не стартует без него.
DJANGO_SECRET_KEY=zamenite-etot-kluch-na-sluchaynyy-ne-menee-50-simvolov-dlinoy
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=s3raphim-dev.ru,www.s3raphim-dev.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://s3raphim-dev.ru,https://www.s3raphim-dev.ru
# Канонический адрес сайта: используется в sitemap, письмах и микроразметке.
SITE_URL=https://s3raphim-dev.ru

# --- База данных ----------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/modern_machinery

# --- Параметры контейнера с базой ------------------------------------------
# Используются docker compose. В dev-профиле есть значения по умолчанию,
# в production-профиле переменные обязательны.
POSTGRES_DB=modern_machinery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Redis, Celery --------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# Бэкенд кэша. По умолчанию берётся REDIS_URL.
# Для машины без Redis укажите locmem:// — приложение полностью работоспособно.
CACHE_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# --- Почта ----------------------------------------------------------------
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=site@modernmachinery.ru
# Резервный адрес, если ни одно правило маршрутизации не подошло.
LEADS_FALLBACK_EMAIL=office@modernmachinery.ru

# --- Защита форм заявок ---------------------------------------------------
# Дросселирование POST на создание заявки: по одному IP.
LEAD_THROTTLE_RATE=20/hour
LEAD_THROTTLE_BURST_RATE=3/min
# Минимальное время заполнения формы в секундах: быстрее заполняет только бот.
LEAD_MIN_FORM_SECONDS=3
# Окно дедупликации одинаковых заявок с одного IP, в секундах.
LEAD_DEDUPE_WINDOW_SECONDS=300
# Срок хранения персональных данных заявки в днях (152-ФЗ).
LEAD_RETENTION_DAYS=365

# --- Медиа ----------------------------------------------------------------
# По умолчанию файлы лежат в локальном томе. Для S3 достаточно переключить флаг.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# --- Мониторинг -----------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# --- Домен и TLS ------------------------------------------------------------
# Домен, на который выпускается сертификат Let's Encrypt. Используется nginx
# и командой выпуска сертификата.
DOMAIN=s3raphim-dev.ru
# Второе имя (обычно www). Оставьте пустым, если оно не нужно.
DOMAIN_ALIAS=www.s3raphim-dev.ru
# Почта для уведомлений Let's Encrypt об истечении сертификата.
CERTBOT_EMAIL=admin@s3raphim-dev.ru
# Тестовый режим: выпускает недоверенный сертификат, но не тратит лимит
# Let's Encrypt (5 выпусков на домен в неделю). Прогоните с ним первый раз.
CERTBOT_STAGING=0

# Принудительный переход на https. Выключать нельзя: сайт собирает
# персональные данные, и по http они пойдут открытым текстом.
DJANGO_SECURE_SSL_REDIRECT=True
